a:["$","section","subject",{"id":"subject","className":"offer-section","children":[["$","div",null,{"className":"offer-section-head","children":[["$","span",null,{"className":"offer-section-number","children":"02"}],["$","h2",null,{"className":"offer-section-title","children":"Предмет договора и порядок акцепта"}]]}],"$undefined","$undefined",[["$","p","2.1. Исполнитель обязует",{"className":"offer-text","children":"2.1. Исполнитель обязуется оказать Заказчику (или указанному им несовершеннолетнему Ученику) услуги по обучению математике (подготовка к ЦЭ/ЦТ) в соответствии с выбранным Тарифом, а Заказчик обязуется их оплатить."}],["$","p","2.2. Акцептом (заключени",{"className":"offer-text","children":"2.2. Акцептом (заключением) Договора признается факт 100% предоплаты Тарифа Заказчиком на сайте."}]],"$undefined"]}]
b:["$","section","lives",{"id":"lives","className":"offer-section offer-section--accent","children":[["$","div",null,{"className":"offer-section-head","children":[["$","span",null,{"className":"offer-section-number","children":"03"}],["$","h2",null,{"className":"offer-section-title","children":"Условия геймификации и «Системы жизней»"}]]}],["$","p",null,{"className":"offer-text","children":"Выбирая Тариф, предусматривающий «Систему жизней», Заказчик и Ученик соглашаются со следующими правилами:"}],"$undefined",[["$","p","3.2. В случае списания в",{"className":"offer-text","children":"3.2. В случае списания всех доступных «жизней» за систематическое невыполнение требований преподавателя и куратора, доступ Ученика к онлайн-занятиям в реальном времени и проверке домашних заданий куратором блокируется (Ученик отчисляется с курса)."}],["$","p","3.3. Блокировка доступа ",{"className":"offer-text","children":"3.3. Блокировка доступа к курсу за потерю всех «жизней» признается Сторонами отказом Заказчика от дальнейшего получения услуг. В этом случае Исполнитель производит расчет и возврат остатка денежных средств в соответствии с Разделом 5 настоящего Договора — пропорционально неиспользованному времени обучения и за вычетом всех фактически понесенных Исполнителем расходов на организацию обучения Ученика (включая оплату платформы, услуг куратора и банковские комиссии)."}]],["$","ul",null,{"className":"offer-list","children":[["$","li","0",{"children":"Ученику на определенный период (полный месяц) выделяется фиксированное количество «жизней» — 3."}],["$","li","1",{"children":"За каждое невыполненное или сданное позже установленного срока обязательное домашнее задание с Ученика списывается 1 (одна) жизнь."}]]}]]}]
